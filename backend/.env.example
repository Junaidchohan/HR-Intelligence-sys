# Copy to .env and fill in real values for production use.

# --- Database ---
# SQLite is the default and requires no setup. For Postgres use:
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/talent
DATABASE_URL=sqlite:///./talent.db

# --- Auth ---
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALGORITHM=HS256

# Seed admin user created on first startup
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin

# --- GitHub connector (real integration) ---
# Personal access token: https://github.com/settings/tokens (no scopes needed
# for public read access; classic token or fine-grained both work)
GITHUB_TOKEN=
# Set to "true" to force use of local JSON fixtures in backend/fixtures/github/
# instead of live API calls (useful for offline dev/demo/testing).
GITHUB_OFFLINE_FIXTURES=true

# --- Optional: LLM-written screening summaries ---
# Get a key at https://console.anthropic.com/. Leave unset to use the
# built-in rule-based summary instead (scores/recommendations are always
# rule-based regardless of this setting).
ANTHROPIC_API_KEY=
SCREENING_USE_LLM_SUMMARY=false

GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_OFFLINE_FIXTURES=false